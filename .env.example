# Copy to .env and adjust. Never commit .env.

# --- Postgres ---
POSTGRES_DB=daret
POSTGRES_USER=daret
POSTGRES_PASSWORD=daret

# --- Backend ---
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/daret
SPRING_DATASOURCE_USERNAME=daret
SPRING_DATASOURCE_PASSWORD=daret
# JWT signing secret — MUST be overridden in any real deployment (>= 32 bytes, base64).
# Generate: openssl rand -base64 48
DARET_JWT_SECRET=ZGV2LW9ubHktc2VjcmV0LWNoYW5nZS1tZS1pbi1wcm9kdWN0aW9uLTEyMzQ1Ng==
DARET_JWT_ACCESS_TTL_MIN=15
DARET_JWT_REFRESH_TTL_DAYS=30

# Auth rate limit (per client IP). Raise for load tests / E2E.
DARET_AUTH_RATELIMIT_MAX=10
DARET_AUTH_RATELIMIT_WINDOW=60

# Mock payment provider (MVP). Set failure rate > 0 to exercise retries/defaults.
DARET_MOCK_FAILURE_RATE=0.0
# settle-immediately=false simulates async PSP settlement (intents stay PENDING,
# settled later by the webhook or the poll reconciler).
DARET_MOCK_SETTLE_IMMEDIATELY=true
DARET_MOCK_AUTO_SETTLE_ON_POLL=false

# HMAC-SHA256 secret to verify inbound PSP settlement webhooks — override in prod.
DARET_PSP_WEBHOOK_SECRET=dev-webhook-secret-change-me

# Scheduler (cycle pipeline + default sweep). Disable in tests.
DARET_SCHEDULER_ENABLED=true

# Demo data seeder — NEVER enable in production.
DARET_SEED_ENABLED=false

# --- Frontend ---
# Browser-facing base URL of the API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Primary locale: fr | ar | darija
NEXT_PUBLIC_DEFAULT_LOCALE=fr
# Optional: error reporting (integration point in src/lib/observability.ts).
NEXT_PUBLIC_SENTRY_DSN=
